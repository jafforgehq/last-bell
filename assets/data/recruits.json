{
  "version": 1,
  "authored": {
    "ana": {"line": "County hospital, third floor. I am a nurse, I have a bag of supplies and nowhere left to put them. I heard your signal this morning. Is there a bed behind that wall?"},
    "walt": {"line": "Retired police, twenty-six years on the force. I still have my service pistol and a hip that forecasts rain. I can hold a line, if you have a line to hold."},
    "hector": {"line": "I kept the keys to every door in this district, and the ones I could not open I took off the hinges. I am quiet, I am good with a wrench, and I am very tired of sleeping in the boiler room."}
  },
  "first": ["Mia", "Tomas", "Nia", "Owen", "Lena", "Karim", "June", "Pavel", "Abel", "Priya", "Soren", "Imani", "Jonas", "Marisol", "Dmitri", "Hana", "Eli", "Rosa", "Kofi", "Annika", "Luis", "Greta", "Idris", "Wren", "Tobias", "Yara", "Cal", "Noor", "Stan", "Beth", "Joaquin", "Mei", "Gus", "Tamsin", "Raul", "Femi", "Olga", "Declan", "Sunita", "Matteo"],
  "last": ["Hale", "Ortiz", "Brandt", "Nakamura", "Costa", "Adeyemi", "Fisher", "Novak", "Lindqvist", "Okonkwo", "Patel", "Moreau", "Kowalski", "Haddad", "Whitfield", "Sandoval", "Petrov", "Abara", "Nguyen", "Tran", "Mbeki", "Larsen", "Vasquez", "Greer", "Ashby", "Duarte", "Yoon", "Cardoso", "Rahimi", "Thornton"],
  "roles": [
    {
      "role": "Nurse",
      "weight": 1.0,
      "weapon": "pistol",
      "skills": {
        "Shooting": [1, 4],
        "Melee": [0, 3],
        "Building": [1, 3],
        "Medicine": [5, 8],
        "Leading": [1, 4]
      },
      "traits_bias": ["triage", "optimist", "steady", "quick_learner"],
      "line": "Is anyone there? I'm a nurse. I've been dressing wounds in a stairwell for six days with the last of a first-aid kit, and I'd rather do it where somebody can hold the flashlight.",
      "line_in": "Nurse. Where do you keep your supplies? I'll start there."
    },
    {
      "role": "Mechanic",
      "weight": 1.0,
      "weapon": "rifle",
      "skills": {
        "Shooting": [2, 5],
        "Melee": [2, 5],
        "Building": [5, 8],
        "Medicine": [0, 2],
        "Leading": [0, 3]
      },
      "traits_bias": ["tinkerer", "tough", "steady_hands"],
      "line": "Can you hear me? I fix engines, and I've been fixing the same truck for three days while something knocked on the door. Tell me you've got a garage and I'll be useful.",
      "line_in": "Got grease on my hands and a rifle on my back. Point me at whatever's broken."
    },
    {
      "role": "Farmer",
      "weight": 1.0,
      "weapon": "shotgun",
      "skills": {
        "Shooting": [3, 6],
        "Melee": [2, 5],
        "Building": [3, 7],
        "Medicine": [1, 3],
        "Leading": [1, 3]
      },
      "traits_bias": ["tough", "steady", "optimist"],
      "line": "Hello? I'm a farmer, two days' walk from you if the roads hold. I've got seed in my pockets and a shotgun I'd rather not use, and I'm tired of eating out of cans.",
      "line_in": "I brought seed. Hope you've got dirt that isn't concrete."
    },
    {
      "role": "Teacher",
      "weight": 1.0,
      "weapon": "pike",
      "skills": {
        "Shooting": [0, 3],
        "Melee": [0, 3],
        "Building": [1, 3],
        "Medicine": [1, 4],
        "Leading": [4, 7]
      },
      "traits_bias": ["steady", "loyal", "quick_learner", "optimist"],
      "line": "Please answer. I'm a teacher, and I've spent four days keeping a classroom door shut with a bookcase. I can stand a post, I've got a sharpened broom handle, and I can't do this alone much longer.",
      "line_in": "Sorry I'm late. I got held up. Where would you like me?"
    },
    {
      "role": "Cook",
      "weight": 0.9,
      "weapon": "pike",
      "skills": {
        "Shooting": [0, 3],
        "Melee": [3, 7],
        "Building": [1, 4],
        "Medicine": [1, 3],
        "Leading": [2, 5]
      },
      "traits_bias": ["optimist", "loyal", "tough"],
      "line": "Anyone? I cook for a living, and I have been feeding myself on crackers for a week. If you have a stove and a few cans, I promise I can make them last.",
      "line_in": "I smell soup. Tell me that's soup."
    },
    {
      "role": "Paramedic",
      "weight": 0.9,
      "weapon": "pistol",
      "skills": {
        "Shooting": [1, 4],
        "Melee": [1, 4],
        "Building": [1, 3],
        "Medicine": [4, 7],
        "Leading": [2, 5]
      },
      "traits_bias": ["triage", "steady", "tough"],
      "line": "Radio check, anybody? I'm a paramedic and I'm out of ambulance. I've got a bag with a few good things left in it, and I can keep people breathing if you can keep them safe.",
      "line_in": "Where do you want the bag? I'll triage as I walk."
    },
    {
      "role": "Hunter",
      "weight": 0.8,
      "weapon": "hunting",
      "skills": {
        "Shooting": [5, 8],
        "Melee": [2, 5],
        "Building": [1, 4],
        "Medicine": [0, 3],
        "Leading": [0, 3]
      },
      "traits_bias": ["sharp_eyed", "steady_hands", "steady"],
      "line": "Hello, the school? I hunt for a living, or I did. I've got a rifle, two boxes of shells and a good eye, and I can watch a treeline all night if there's a roof to sit under.",
      "line_in": "Show me where the best view is. I'll take the first night."
    },
    {
      "role": "Student",
      "weight": 0.9,
      "weapon": "pistol",
      "skills": {
        "Shooting": [1, 5],
        "Melee": [1, 4],
        "Building": [1, 5],
        "Medicine": [0, 3],
        "Leading": [0, 2]
      },
      "traits_bias": ["quick_learner", "nervous", "optimist"],
      "line": "Hi, sorry, I'm a student and I don't know who else to call. I've been in a library since the first night, I'm good at being quiet, and I don't want to be alone anymore.",
      "line_in": "I made it. Is it okay that I'm here?"
    },
    {
      "role": "Electrician",
      "weight": 0.9,
      "weapon": "rifle",
      "skills": {
        "Shooting": [1, 4],
        "Melee": [1, 3],
        "Building": [4, 7],
        "Medicine": [0, 2],
        "Leading": [1, 3]
      },
      "traits_bias": ["tinkerer", "steady_hands", "quick_learner"],
      "line": "Can you hear me? I'm an electrician. I can bring a dead panel back to life, and if you've got a generator I'd like to see it, because I can make it do more than hum.",
      "line_in": "Where's your breaker box? I like to start with the dark."
    },
    {
      "role": "Shopkeeper",
      "weight": 0.9,
      "weapon": "shotgun",
      "skills": {
        "Shooting": [2, 5],
        "Melee": [1, 4],
        "Building": [1, 4],
        "Medicine": [0, 3],
        "Leading": [3, 7]
      },
      "traits_bias": ["loyal", "steady", "optimist"],
      "line": "I kept a shop on a good street, and a shotgun under the counter for bad days. This counts as one. Have you got room for someone who knows how to count stock?",
      "line_in": "I brought what I could carry. Anything you need counted?"
    },
    {
      "role": "Bus driver",
      "weight": 0.9,
      "weapon": "pistol",
      "skills": {
        "Shooting": [1, 4],
        "Melee": [2, 5],
        "Building": [2, 5],
        "Medicine": [0, 3],
        "Leading": [2, 6]
      },
      "traits_bias": ["steady", "tough", "loyal"],
      "line": "Hello, anyone? I'm a bus driver, and I've been parked behind a church for a week with a full tank and nowhere to take it. If you've got a gate that opens, I know every back road to it.",
      "line_in": "End of the line, and I'm the only passenger."
    },
    {
      "role": "Carpenter",
      "weight": 1.0,
      "weapon": "pike",
      "skills": {
        "Shooting": [1, 4],
        "Melee": [2, 5],
        "Building": [5, 8],
        "Medicine": [0, 2],
        "Leading": [1, 3]
      },
      "traits_bias": ["tinkerer", "tough", "steady_hands"],
      "line": "Is this thing on? I'm a carpenter, and I've been holed up in a half-built house with a nail bag and a lot of opinions about walls. Let me show you what a proper joist can hold.",
      "line_in": "Let's see your walls. I brought a hammer."
    },
    {
      "role": "Night guard",
      "weight": 0.8,
      "weapon": "service",
      "skills": {
        "Shooting": [4, 7],
        "Melee": [2, 5],
        "Building": [1, 3],
        "Medicine": [0, 3],
        "Leading": [2, 5]
      },
      "traits_bias": ["sharp_eyed", "steady", "tough"],
      "line": "Hello? I was the night guard at a warehouse, and the night got a lot longer than my shift. I have an old rifle and plenty of practice standing still while something moves.",
      "line_in": "Just point me at a wall and a clock. I'll do the rest."
    },
    {
      "role": "Pharmacist",
      "weight": 0.8,
      "weapon": "pistol",
      "skills": {
        "Shooting": [0, 3],
        "Melee": [0, 3],
        "Building": [0, 3],
        "Medicine": [4, 7],
        "Leading": [1, 4]
      },
      "traits_bias": ["triage", "steady_hands", "quick_learner"],
      "line": "Anyone there? I'm a pharmacist, and I walked out with every bottle I could carry before the shop went dark. I'd like to trade my pills for a roof and a wall, if you'll have me.",
      "line_in": "I labelled everything in this bag. Please don't tip it out."
    }
  ],
